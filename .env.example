# Required: ElevenLabs API key (server-side only, never exposed to the browser)
ELEVENLABS_API_KEY=

# Optional: SQLite file path (default: ./data/bench.db)
DATABASE_PATH=./data/bench.db

# Optional: LLM-as-judge scoring. Leave empty to disable.
# JUDGE_PROVIDER: anthropic | openai
JUDGE_PROVIDER=
JUDGE_API_KEY=
JUDGE_MODEL=
# Optional model for scenario generation (same provider and key as the judge). Defaults to JUDGE_MODEL.
ASSIST_MODEL=

# Optional: runner settings
BENCH_CONCURRENCY=2
BENCH_MAX_RUNS=50
